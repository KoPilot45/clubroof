{
  "expo": {
    "name": "Clubroof",
    "slug": "clubroof",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "clubroof",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "de.clubroof.app",
      "supportsTablet": true,
      "requireFullScreen": true
    },
    "android": {
      "package": "de.clubroof.app",
      "adaptiveIcon": {
        "backgroundColor": "#E3F4E7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F2F5F3",
          "dark": { "backgroundColor": "#0B120E" }
        }
      ],
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Clubroof nutzt die Kamera, um Einladungs-QR-Codes zu scannen.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        { "faceIDPermission": "Clubroof nutzt Face ID, um die App zu entsperren." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
