{
  "name": "@clubroof/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./migrate": "./src/migrate.ts",
    "./seed": "./src/seed/index.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed/index.ts",
    "reset": "tsx --env-file-if-exists=../../.env src/reset.ts"
  },
  "dependencies": {
    "@clubroof/core": "workspace:*",
    "@clubroof/design-tokens": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "@node-rs/argon2": "^2.2.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
