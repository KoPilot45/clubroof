# Antonia Rüller – Apache-Konfiguration (Ionos)
Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
RewriteEngine On
# HTTPS erzwingen (Schleifenschutz: nicht bei Port 443 und nicht hinter einem HTTPS-Proxy)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{SERVER_PORT} !^443$
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# www auf die Hauptadresse umleiten
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# robots.txt/sitemap.xml/llms.txt (falls die Dateien fehlen)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^robots\.txt$ robots.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^llms\.txt$ llms.php [L]
</IfModule>

# Interne Ordner und Dateien sperren
<IfModule mod_authz_core.c>
<FilesMatch "^(config(\.sample)?\.php|\.gitignore|README.*|.*\.sqlite.*|.*\.log|error_log|php_errorlog|.*\.bak|.*\.sql|.*~|\.user\.ini|php\.ini)$">
Require all denied
</FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
<FilesMatch "^(config(\.sample)?\.php|\.gitignore|README.*|.*\.sqlite.*|.*\.log|error_log|php_errorlog|.*\.bak|.*\.sql|.*~|\.user\.ini|php\.ini)$">
Order allow,deny
Deny from all
</FilesMatch>
</IfModule>

# Zwischenspeicherung statischer Dateien
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType image/x-icon "access plus 1 week"
ExpiresByType image/vnd.microsoft.icon "access plus 1 week"
</IfModule>

# Komprimierung
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

# Sicherheits-Kopfzeilen auch für statische Dateien (PHP-Seiten setzen zusätzlich eine strenge Content-Security-Policy)
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>
