# Lokale Entwicklungsdatenbank (siehe infra/docker-compose.yml)
DATABASE_URL=postgres://clubroof:clubroof@localhost:5432/clubroof

# ── Für den Server (Produktion) – lokal nicht nötig ─────────────────────────
# NODE_ENV=production
# PUBLIC_API_URL=https://api.mein-verein.de       # Adresse der API (für Datei-Links)
# APP_URL=https://app.mein-verein.de              # Adresse der Web-App (für Links in E-Mails)
# CORS_ORIGINS=https://app.mein-verein.de
# SMTP_URL=smtps://benutzer:passwort@smtp.anbieter.de:465
# MAIL_FROM="SV Muster <no-reply@mein-verein.de>"
# DATA_ENCRYPTION_KEY=                            # langer Zufallswert, z. B. openssl rand -base64 32
# FILE_SIGNING_SECRET=                            # langer Zufallswert
# SETUP_TOKEN=                                    # Einmal-Code für den Einrichtungsassistenten
# UPLOADS_DIR=/var/lib/clubroof/uploads
# PUSH_PROVIDER=expo                              # in Produktion Standard; lokal: log
# EXPO_ACCESS_TOKEN=                              # optional, wenn im Expo-Konto Push-Sicherheit aktiv ist
# JOBS_ENABLED=true                               # Erinnerungen, Sammelhinweise, Push-Versand
